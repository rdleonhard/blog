---
import { SITE } from "../lib/site";
import { basePath, sitePath } from "../lib/paths";

interface Props {
  title?: string;
  description?: string;
  ogType?: "website" | "article";
}

const {
  title = SITE.title,
  description = SITE.description,
  ogType = "website",
} = Astro.props;

const pageTitle = title === SITE.title ? title : `${title} | ${SITE.title}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const rssUrl = new URL(sitePath("rss.xml"), Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <meta name="theme-color" content="#070812" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} RSS`} href={rssUrl} />
    <link
      rel="alternate"
      type="application/feed+json"
      title={`${SITE.title} JSON Feed`}
      href={new URL(sitePath("feed.json"), Astro.site)}
    />
    <title>{pageTitle}</title>
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Blog",
        name: SITE.title,
        description: SITE.description,
        url: new URL(basePath, Astro.site).toString(),
        author: { "@type": "Person", name: SITE.author },
        inLanguage: "en",
      })}
    />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={basePath}>
        <span class="brand-mark">PS</span>
        <span class="brand-copy">
          <span>{SITE.title}</span>
          <span>by {SITE.author}</span>
        </span>
      </a>
      <nav aria-label="Primary navigation">
        <a href={sitePath("codex/")}>Codex</a>
        <a href={sitePath("posts/")}>Posts</a>
        <a href={sitePath("tags/")}>Tags</a>
        <a href={sitePath("about/")}>About</a>
        <a href={sitePath("rss.xml")}>RSS</a>
        <a href={SITE.repo}>Source</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>{SITE.signal} Written by {SITE.author} and published as static files before everything becomes a stream.</p>
      <div class="footer-links">
        <a href={sitePath("codex/")}>Codex</a>
        <a href={sitePath("glossary/")}>Glossary</a>
        <a href={sitePath("codex.txt")}>Codex.txt</a>
        <a href={sitePath("rss.xml")}>RSS</a>
        <a href={sitePath("sitemap.xml")}>Sitemap</a>
        <a href={SITE.repo}>Source</a>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --bg: #070812;
    --bg-elevated: #101322;
    --ink: #edf7ff;
    --muted: #94a3b8;
    --line: rgba(125, 249, 255, 0.2);
    --accent: #7df9ff;
    --accent-dark: #ff4fd8;
    --warning: #f8f871;
    --shadow: 0 24px 90px rgba(0, 0, 0, 0.42);
    --serif: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif;
    --sans: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    --mono: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--bg);
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    min-height: 100vh;
    color: var(--ink);
    background:
      linear-gradient(rgba(125, 249, 255, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(125, 249, 255, 0.035) 1px, transparent 1px),
      radial-gradient(circle at 18% 10%, rgba(255, 79, 216, 0.2), transparent 30rem),
      radial-gradient(circle at 82% 18%, rgba(125, 249, 255, 0.16), transparent 28rem),
      linear-gradient(135deg, #070812 0%, #101322 52%, #070812 100%);
    background-size:
      48px 48px,
      48px 48px,
      auto,
      auto,
      auto;
    font-family: var(--sans);
    line-height: 1.6;
    text-rendering: optimizeLegibility;
  }

  body::before {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    content: "";
    background: linear-gradient(rgba(237, 247, 255, 0.04) 50%, rgba(7, 8, 18, 0.08) 50%);
    background-size: 100% 4px;
    mix-blend-mode: screen;
  }

  a {
    color: inherit;
    text-decoration-color: rgba(125, 249, 255, 0.45);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.18em;
  }

  a:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }

  a:focus-visible {
    outline: 3px solid rgba(125, 249, 255, 0.42);
    outline-offset: 4px;
    border-radius: 6px;
  }

  img {
    display: block;
    max-width: 100%;
  }

  main {
    width: min(1120px, calc(100% - 32px));
    margin: 0 auto;
  }

  .site-header,
  .site-footer {
    width: min(1120px, calc(100% - 32px));
    margin: 0 auto;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 28px 0;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--ink);
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .brand-copy {
    display: grid;
    gap: 2px;
  }

  .brand-copy span:last-child {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  .brand-mark {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border: 1px solid var(--accent);
    border-radius: 12px;
    color: var(--accent);
    font-family: var(--mono);
    font-size: 0.9rem;
    letter-spacing: 0.04em;
    box-shadow: 0 0 28px rgba(125, 249, 255, 0.25);
  }

  nav {
    display: flex;
    align-items: center;
    gap: 18px;
    color: var(--muted);
    font-size: 0.92rem;
    font-weight: 650;
  }

  nav a {
    text-decoration: none;
  }

  .site-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 64px 0 40px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.95rem;
  }

  .site-footer p {
    margin: 0;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    font-weight: 700;
  }

  .footer-links a {
    text-decoration: none;
  }

  .eyebrow {
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    font-family: var(--mono);
    text-transform: uppercase;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 20px;
    border: 1px solid var(--ink);
    border-radius: 999px;
    background: var(--ink);
    color: var(--bg);
    font-weight: 750;
    text-decoration: none;
    transition:
      transform 160ms ease,
      box-shadow 160ms ease,
      background 160ms ease;
  }

  .button:hover {
    transform: translateY(-2px);
    background: var(--accent);
    color: var(--bg);
    box-shadow: 0 0 28px rgba(125, 249, 255, 0.34);
  }

  .button.secondary {
    background: transparent;
    color: var(--ink);
  }

  .button.secondary:hover {
    background: rgba(125, 249, 255, 0.1);
    color: var(--accent);
  }

  .post-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: 28px;
    background: rgba(16, 19, 34, 0.76);
    box-shadow: 0 16px 56px rgba(0, 0, 0, 0.22);
    transition:
      transform 160ms ease,
      border-color 160ms ease,
      box-shadow 160ms ease;
  }

  .post-card:hover,
  .post-card:focus-within {
    transform: translateY(-3px);
    border-color: rgba(125, 249, 255, 0.48);
    box-shadow: var(--shadow);
  }

  .post-card :where(h2, h3),
  .post-card-title {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(1.5rem, 2vw, 2.15rem);
    line-height: 1.14;
    letter-spacing: -0.03em;
    font-weight: 500;
  }

  /* Whole-card click target while keeping tags independently clickable. */
  .card-link {
    color: var(--ink);
    text-decoration: none;
  }

  .card-link::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .post-card:hover .card-link {
    color: var(--accent);
  }

  .card-link:focus-visible {
    outline: none;
  }

  .post-card:focus-within {
    outline: 3px solid rgba(125, 249, 255, 0.42);
    outline-offset: 4px;
  }

  .post-card p {
    margin: 0;
    color: var(--muted);
  }

  .post-meta,
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    color: var(--muted);
    font-size: 0.86rem;
  }

  .post-meta .dot {
    color: var(--accent-dark);
  }

  .tag-list {
    position: relative;
    z-index: 1;
    margin-top: auto;
  }

  .tag {
    border: 1px solid rgba(125, 249, 255, 0.32);
    border-radius: 999px;
    padding: 4px 11px;
    color: var(--accent);
    background: rgba(125, 249, 255, 0.08);
    font-size: 0.76rem;
    font-weight: 750;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      background 140ms ease,
      border-color 140ms ease,
      color 140ms ease;
  }

  a.tag:hover {
    color: var(--bg);
    background: var(--accent);
    border-color: var(--accent);
  }

  .prose {
    max-width: 740px;
    margin: 0 auto;
    font-family: var(--serif);
    font-size: clamp(1.13rem, 1.8vw, 1.28rem);
    line-height: 1.78;
  }

  .prose :where(h2, h3) {
    margin-top: 2.1em;
    margin-bottom: 0.45em;
    color: var(--ink);
    font-family: var(--sans);
    line-height: 1.2;
    letter-spacing: -0.03em;
  }

  .prose h2 {
    font-size: clamp(1.6rem, 2.5vw, 2.1rem);
  }

  .prose h3 {
    font-size: clamp(1.25rem, 2vw, 1.55rem);
  }

  .prose p {
    margin: 1.15em 0;
  }

  .prose a {
    color: var(--accent);
    font-weight: 650;
  }

  .prose :where(ul, ol) {
    padding-left: 1.35rem;
  }

  .prose li + li {
    margin-top: 0.35rem;
  }

  .prose blockquote {
    margin: 2rem 0;
    padding: 0.2rem 0 0.2rem 1.4rem;
    border-left: 3px solid var(--accent-dark);
    color: var(--ink);
    font-style: italic;
  }

  .prose hr {
    margin: 2.6rem 0;
    border: none;
    border-top: 1px solid var(--line);
  }

  .prose code {
    padding: 0.15em 0.4em;
    border-radius: 6px;
    background: rgba(125, 249, 255, 0.1);
    font-family: var(--mono);
    font-size: 0.86em;
  }

  .prose :where(pre) {
    overflow-x: auto;
    padding: 1.1rem 1.2rem;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: rgba(4, 5, 12, 0.6);
  }

  .prose pre code {
    padding: 0;
    background: none;
  }

  /* Drop cap on the opening line of a transmission. */
  .prose > p:first-of-type::first-letter {
    float: left;
    margin: 0.02em 0.12em 0 0;
    color: var(--accent);
    font-family: var(--serif);
    font-size: 3.4em;
    font-weight: 600;
    line-height: 0.72;
  }

  /* Reading progress rail, driven by a small script on post pages. */
  .reading-progress {
    position: fixed;
    inset: 0 auto auto 0;
    z-index: 20;
    width: 100%;
    height: 3px;
    transform: scaleX(0);
    transform-origin: 0 50%;
    background: linear-gradient(90deg, var(--accent), var(--accent-dark));
    box-shadow: 0 0 14px rgba(125, 249, 255, 0.5);
    will-change: transform;
  }

  /* Previous / next transmission navigation. */
  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    max-width: 860px;
    margin: 12px auto 0;
    padding-top: 40px;
    border-top: 1px solid var(--line);
  }

  .post-nav a {
    display: grid;
    gap: 6px;
    padding: 20px 22px;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: rgba(16, 19, 34, 0.6);
    text-decoration: none;
    transition:
      transform 160ms ease,
      border-color 160ms ease;
  }

  .post-nav a:hover {
    transform: translateY(-2px);
    border-color: rgba(125, 249, 255, 0.48);
  }

  .post-nav a.next {
    text-align: right;
  }

  .post-nav .direction {
    color: var(--accent);
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .post-nav .nav-title {
    color: var(--ink);
    font-family: var(--serif);
    font-size: 1.15rem;
    line-height: 1.2;
  }

  /* Related transmissions block. */
  .related {
    max-width: 860px;
    margin: 56px auto 0;
  }

  .related > .eyebrow {
    display: block;
    margin-bottom: 18px;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  @media (max-width: 760px) {
    .post-nav,
    .related-grid {
      grid-template-columns: 1fr;
    }

    .post-nav a.next {
      text-align: left;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      animation-duration: 0.001ms !important;
      transition-duration: 0.001ms !important;
    }
  }

  @media (max-width: 720px) {
    .site-header {
      align-items: flex-start;
      flex-direction: column;
    }

    .site-footer {
      align-items: flex-start;
      flex-direction: column;
    }

    nav {
      width: 100%;
      flex-wrap: wrap;
      justify-content: space-between;
      row-gap: 8px;
    }

    .brand {
      font-size: 0.75rem;
    }
  }

  /* A codex should print. Black serif on white, chrome stripped, links legible. */
  @media print {
    :root {
      color-scheme: light;
    }

    html,
    body {
      background: #fff !important;
      color: #000;
    }

    body::before {
      display: none;
    }

    .site-header nav,
    .site-footer,
    .reading-progress,
    .post-nav,
    .related,
    .hero-actions,
    .tag-filter,
    .button {
      display: none !important;
    }

    .brand,
    .brand-copy span,
    .eyebrow,
    .post-meta,
    .tag-list,
    .tag,
    p,
    li,
    blockquote {
      color: #000 !important;
      text-shadow: none !important;
      box-shadow: none !important;
    }

    .brand-mark {
      border-color: #000;
      box-shadow: none;
    }

    h1,
    h2,
    h3,
    .post-card :where(h2, h3),
    .post-card-title,
    .prose :where(h2, h3) {
      color: #000 !important;
    }

    .post-card,
    .hero-panel,
    .glossary-entry {
      border: 1px solid #999 !important;
      background: #fff !important;
      box-shadow: none !important;
    }

    a {
      color: #000;
      text-decoration: underline;
    }

    .prose {
      font-size: 12pt;
      color: #000;
    }

    .prose > p:first-of-type::first-letter {
      color: #000;
    }

    .prose a::after {
      content: " (" attr(href) ")";
      font-size: 0.75em;
      color: #444;
    }

    @page {
      margin: 2cm;
    }
  }
</style>
