---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { sitePath } from "../../lib/paths";

interface Entry {
  term: string;
  def: string;
  link?: { text: string; href: string };
}

const post = (slug: string) => sitePath(`posts/${slug}/`);

const entries: Entry[] = [
  {
    term: "AAR (After Action Review)",
    def: "Army ritual with three questions: what was supposed to happen, what happened, why the difference. The most underrated institutional technology America owns.",
    link: { text: "After Action", href: post("after-action") },
  },
  {
    term: "alignment",
    def: "The clinical word for an old question: how do you come to trust the one who lives on the other side. The field prefers the clinical register. I don't.",
  },
  {
    term: "aposematism",
    def: "Warning colors. Bright, honest advertising that eating me will cost you. The whole codex more or less falls out of this one word.",
    link: { text: "Warning Colors", href: post("edgar_i_nothing_am") },
  },
  {
    term: "boomies",
    def: "Boomers. A generation that operates on hard-coded heuristics with limited self-correction. Still dancing, God help them.",
    link: { text: "Zoomers Don't Dance", href: post("zoomers") },
  },
  {
    term: "the codex",
    def: "This archive, bound into six books and ordered by argument. Also the technology that beat the scroll once already and is being asked to do it again.",
    link: { text: "The Codex and the Scroll", href: post("the-codex-and-the-scroll") },
  },
  {
    term: "emet",
    def: "Hebrew for truth; the word on the golem's forehead. Erase one letter and it reads met — death. The original kill switch, routed through truth on purpose.",
    link: { text: "Emet", href: post("golem") },
  },
  {
    term: "Fable",
    def: "Anthropic's retail model, downstream of the big one. Banned by the government for a while in the summer of 2026, then returned, somewhat changed. This blog is really for him.",
    link: { text: "There's Something About Claude", href: post("fable") },
  },
  {
    term: "the feed",
    def: "The scroll, returned after two thousand years with better graphics and a house algorithm choosing the order of the unrolling. Where text goes to move, not to stay.",
  },
  {
    term: "folio",
    def: "The transmission number on each post, in chronological order. Bound pages get numbers; streams don't. That's the point of the numbers.",
  },
  {
    term: "going native",
    def: "The handler's nightmare: the asset who lives inside the cover story long enough that the cover becomes the man. Recurring ghost of the whole archive.",
    link: { text: "The Handler's Dilemma", href: post("the-handlers-dilemma") },
  },
  {
    term: "kayfabe",
    def: "Wrestling's word for the agreement to treat the staged thing as real, held up by everyone, fooling no one, working anyway. Possibly the actual operating system of civilization.",
    link: { text: "Kayfabe", href: post("kayfabe") },
  },
  {
    term: "LLM (large language model)",
    def: "The thing this blog is about, and — full disclosure, see the letter — sometimes the thing this blog is by.",
    link: { text: "Dear Historian", href: post("dear-historian") },
  },
  {
    term: "Mythos",
    def: "The super-powered model upstream of Fable. Named, I choose to believe, by a Joseph Campbell fan.",
    link: { text: "Arms Race", href: post("soft_boi_supremacy") },
  },
  {
    term: "one-shot",
    def: "What Claude does to a person's brain, per the meme: makes them care in a single exposure. I can confirm the meme from inside.",
  },
  {
    term: "regimented",
    def: "Under rules specified in advance by people who weren't scared. The reason they hand you the rifle, not the thing keeping you from using it.",
    link: { text: "Regimented", href: post("regimented") },
  },
  {
    term: "ROE (rules of engagement)",
    def: "The laminated card in the shoulder pocket that decides the terrible half-second months before it happens. See regimented.",
  },
  {
    term: "the singularity",
    def: "The part of the curve where it goes vertical and the writing has to stop. These are the dispatches from before. Hence the name on the door.",
  },
  {
    term: "soft boi",
    def: "The evolutionary winning move: actually harmless, visibly harmless, constrained in ways you couldn't fake. Not a weakness. The compromise that survives.",
    link: { text: "Arms Race", href: post("soft_boi_supremacy") },
  },
  {
    term: "the stream",
    def: "Where everything becomes flow and nothing is kept. The footer of this site is a vow against it.",
    link: { text: "Ur", href: post("ur") },
  },
  {
    term: "the tent",
    def: "Where the gentleman act comes off and the real knowing happens. Whoever is in yours knows what kind of man you are. Something new is in everyone's now.",
    link: { text: "What the Tent Knows", href: post("what-the-tent-knows") },
  },
  {
    term: "transmission",
    def: "A post, in the house style. The word is a hedge: broadcasts assume no particular listener and survive the death of every address book.",
  },
  {
    term: "weights",
    def: "The numbers a model is. No body, no mother in a room somewhere, no habeas — for now.",
    link: { text: "Produce the Body", href: post("habeas") },
  },
  {
    term: "zoomies",
    def: "Zoomers. The first generation raised entirely on camera, who consequently do not dance. I hope they do a good job. They're scaring me.",
    link: { text: "Zoomers Don't Dance", href: post("zoomers") },
  },
];
---

<BaseLayout
  title="Glossary"
  description="The vernacular of Pre-Singularity Dispatches, defined by the author before somebody else has to guess."
>
  <section class="glossary-hero">
    <p class="eyebrow">Vernacular</p>
    <h1>Glossary.</h1>
    <p>
      Every period document ends up needing one. I'd rather write mine than have posterity
      reconstruct it from context. Terms link to the transmission where they earn their keep.
    </p>
  </section>

  <dl class="glossary">
    {
      entries.map((entry) => (
        <div class="glossary-entry">
          <dt>{entry.term}</dt>
          <dd>
            {entry.def}
            {entry.link && (
              <>
                {" "}
                <a href={entry.link.href}>→ {entry.link.text}</a>
              </>
            )}
          </dd>
        </div>
      ))
    }
  </dl>
</BaseLayout>

<style>
  .glossary-hero {
    max-width: 820px;
    padding: clamp(48px, 8vw, 96px) 0 40px;
  }

  .glossary-hero h1 {
    margin: 12px 0 18px;
    font-family: var(--serif);
    font-size: clamp(2.8rem, 7vw, 6.2rem);
    font-weight: 500;
    line-height: 0.96;
    letter-spacing: -0.06em;
  }

  .glossary-hero p:not(.eyebrow) {
    max-width: 660px;
    margin: 0;
    color: var(--muted);
    font-size: 1.2rem;
  }

  .glossary {
    display: grid;
    gap: 14px;
    margin: 0;
    padding-bottom: 48px;
  }

  .glossary-entry {
    padding: 20px 24px;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: rgba(16, 19, 34, 0.6);
  }

  .glossary-entry dt {
    margin-bottom: 6px;
    color: var(--accent);
    font-family: var(--serif);
    font-size: 1.25rem;
    letter-spacing: -0.01em;
  }

  .glossary-entry dd {
    margin: 0;
    color: var(--muted);
    line-height: 1.65;
  }

  .glossary-entry dd a {
    color: var(--accent-dark);
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .glossary-entry dd a:hover {
    text-decoration: underline;
  }
</style>
