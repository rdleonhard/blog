---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { sitePath } from "../../lib/paths";
import { SITE } from "../../lib/site";
import {
  folioNumbers,
  formatDate,
  getSortedPosts,
  readingTime,
  relatedPosts,
  tagSlug,
  toRoman,
} from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getSortedPosts();
  const folio = folioNumbers(posts);

  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      folio: folio.get(post.id) ?? 0,
      // Posts are sorted newest-first: "previous" = older, "next" = newer.
      newer: index > 0 ? posts[index - 1] : null,
      older: index < posts.length - 1 ? posts[index + 1] : null,
      related: relatedPosts(post, posts),
    },
  }));
}

const { post, folio, newer, older, related } = Astro.props;
const { Content } = await render(post);
const minutes = readingTime(post.body);
const canonical = new URL(sitePath(`posts/${post.id}/`), Astro.site).toString();
const heroImageUrl = post.data.heroImage
  ? new URL(sitePath(post.data.heroImage), Astro.site).toString()
  : undefined;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishDate.toISOString(),
  ...(post.data.updatedDate && { dateModified: post.data.updatedDate.toISOString() }),
  author: { "@type": "Person", name: SITE.author },
  keywords: post.data.tags.join(", "),
  url: canonical,
  mainEntityOfPage: canonical,
  ...(heroImageUrl && { image: heroImageUrl }),
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  image={post.data.heroImage}
  imageAlt={post.data.heroImageAlt}
>
  <div class="reading-progress" id="reading-progress"></div>

  <article class="post">
    <header class="post-hero">
      <a class="back-link" href={sitePath("posts/")}>Signal archive</a>
      <p class="eyebrow">Transmission № {toRoman(folio)}</p>
      <h1>{post.data.title}</h1>
      <p class="dek">{post.data.description}</p>
      <div class="post-meta byline">
        <time datetime={post.data.publishDate.toISOString()}>{formatDate(post.data.publishDate)}</time>
        <span class="dot" aria-hidden="true">•</span>
        <span>{minutes} min read</span>
        {
          post.data.updatedDate && (
            <>
              <span class="dot" aria-hidden="true">•</span>
              <span>Updated {formatDate(post.data.updatedDate)}</span>
            </>
          )
        }
        <span class="dot" aria-hidden="true">•</span>
        <a class="raw-link" href={sitePath(`posts/${post.id}.txt`)} title="Plain-text mirror of this transmission">.txt</a>
      </div>
      <div class="tag-list">
        {
          post.data.tags.map((tag) => (
            <a class="tag" href={sitePath(`tags/${tagSlug(tag)}/`)}>
              {tag}
            </a>
          ))
        }
      </div>
    </header>

    {
      post.data.heroImage && (
        <figure class="post-art">
          <img
            src={sitePath(post.data.heroImage)}
            alt={post.data.heroImageAlt ?? `Illustration for ${post.data.title}`}
            width="1672"
            height="941"
            fetchpriority="high"
            decoding="async"
          />
        </figure>
      )
    }

    <div class="prose">
      <Content />
    </div>
  </article>

  {
    (newer || older) && (
      <nav class="post-nav" aria-label="More transmissions">
        {older ? (
          <a class="prev" href={sitePath(`posts/${older.id}/`)}>
            <span class="direction">← Older</span>
            <span class="nav-title">{older.data.title}</span>
          </a>
        ) : (
          <span />
        )}
        {newer ? (
          <a class="next" href={sitePath(`posts/${newer.id}/`)}>
            <span class="direction">Newer →</span>
            <span class="nav-title">{newer.data.title}</span>
          </a>
        ) : (
          <span />
        )}
      </nav>
    )
  }

  {
    related.length > 0 && (
      <section class="related" aria-labelledby="related-title">
        <p class="eyebrow" id="related-title">
          Related signals
        </p>
        <div class="related-grid">
          {related.map((entry) => (
            <PostCard post={entry} />
          ))}
        </div>
      </section>
    )
  }

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>

<script>
  const bar = document.getElementById("reading-progress");
  if (bar) {
    const update = () => {
      const doc = document.documentElement;
      const scrollable = doc.scrollHeight - doc.clientHeight;
      const ratio = scrollable > 0 ? doc.scrollTop / scrollable : 0;
      bar.style.transform = `scaleX(${Math.min(1, Math.max(0, ratio))})`;
    };
    update();
    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update, { passive: true });
  }
</script>

<style>
  .post {
    padding-bottom: 32px;
  }

  .post-hero {
    max-width: 860px;
    margin: 0 auto;
    padding: clamp(48px, 8vw, 96px) 0 40px;
  }

  .post-art {
    position: relative;
    max-width: 1040px;
    aspect-ratio: 16 / 9;
    margin: 0 auto clamp(42px, 7vw, 72px);
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 32px;
    background: var(--bg-elevated);
    box-shadow: var(--shadow);
  }

  .post-art::after {
    position: absolute;
    inset: 0;
    pointer-events: none;
    content: "";
    box-shadow: inset 0 0 90px rgba(7, 8, 18, 0.32);
  }

  .post-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .back-link {
    display: inline-flex;
    margin-bottom: 32px;
    color: var(--muted);
    font-size: 0.92rem;
    font-weight: 750;
    text-decoration: none;
  }

  .back-link::before {
    content: "<";
    margin-right: 8px;
    color: var(--accent);
  }

  .back-link:hover {
    color: var(--accent);
  }

  .post-hero h1 {
    margin: 12px 0 20px;
    font-family: var(--serif);
    font-size: clamp(2.8rem, 7vw, 6.4rem);
    font-weight: 500;
    line-height: 0.94;
    letter-spacing: -0.06em;
  }

  .post-hero .dek {
    max-width: 720px;
    margin: 0 0 22px;
    color: var(--muted);
    font-size: clamp(1.12rem, 2vw, 1.35rem);
  }

  .byline {
    margin-bottom: 18px;
    font-family: var(--mono);
    font-size: 0.82rem;
    letter-spacing: 0.02em;
  }

  .raw-link {
    color: var(--muted);
    text-decoration: none;
    border-bottom: 1px dotted rgba(125, 249, 255, 0.4);
  }

  .raw-link:hover {
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .post-art {
      border-radius: 20px;
    }
  }
</style>
