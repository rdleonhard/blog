---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { collectTags, getSortedPosts, tagSlug } from "../../lib/posts";

const posts = await getSortedPosts();
const tags = collectTags(posts);

// Group posts by year, preserving newest-first order.
const byYear = new Map<number, typeof posts>();
for (const post of posts) {
  const year = post.data.publishDate.getFullYear();
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push(post);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---

<BaseLayout title="Posts" description="All transmissions from Pre-Singularity Dispatches.">
  <section class="archive-hero">
    <p class="eyebrow">Signal archive</p>
    <h1>Every note from the threshold.</h1>
    <p>
      Observations, field notes, and personal essays from inside the AI transition —
      <span id="post-count">{posts.length}</span> transmissions and counting.
    </p>
  </section>

  <div class="tag-filter" role="group" aria-label="Filter by tag">
    <button type="button" class="filter-chip is-active" data-filter="all">All</button>
    {
      tags.map((tag) => (
        <button type="button" class="filter-chip" data-filter={tag.slug}>
          {tag.tag} <span class="chip-count">{tag.count}</span>
        </button>
      ))
    }
  </div>

  <div id="archive">
    {
      years.map((year) => (
        <section class="year-group" data-year={year} aria-label={`Posts from ${year}`}>
          <h2 class="year-label">{year}</h2>
          <div class="archive-grid">
            {byYear.get(year)!.map((post) => (
              <div class="archive-item" data-tags={post.data.tags.map(tagSlug).join(" ")}>
                <PostCard post={post} heading="h3" />
              </div>
            ))}
          </div>
        </section>
      ))
    }
    <p class="no-results" hidden>No transmissions match that tag yet.</p>
  </div>
</BaseLayout>

<script>
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>(".filter-chip"));
  const items = Array.from(document.querySelectorAll<HTMLElement>(".archive-item"));
  const groups = Array.from(document.querySelectorAll<HTMLElement>(".year-group"));
  const noResults = document.querySelector<HTMLElement>(".no-results");
  const count = document.getElementById("post-count");
  const total = items.length;

  function apply(filter: string) {
    let visible = 0;
    for (const item of items) {
      const tags = (item.dataset.tags ?? "").split(" ");
      const show = filter === "all" || tags.includes(filter);
      item.hidden = !show;
      if (show) visible += 1;
    }
    for (const group of groups) {
      const anyVisible = group.querySelector(".archive-item:not([hidden])");
      group.hidden = !anyVisible;
    }
    if (noResults) noResults.hidden = visible !== 0;
    if (count) count.textContent = String(filter === "all" ? total : visible);
  }

  for (const chip of chips) {
    chip.addEventListener("click", () => {
      chips.forEach((c) => c.classList.toggle("is-active", c === chip));
      apply(chip.dataset.filter ?? "all");
    });
  }
</script>

<style>
  .archive-hero {
    max-width: 820px;
    padding: clamp(48px, 8vw, 96px) 0 36px;
  }

  .archive-hero h1 {
    margin: 12px 0 18px;
    font-family: var(--serif);
    font-size: clamp(2.8rem, 7vw, 6.2rem);
    font-weight: 500;
    line-height: 0.96;
    letter-spacing: -0.06em;
  }

  .archive-hero p:not(.eyebrow) {
    max-width: 640px;
    margin: 0;
    color: var(--muted);
    font-size: 1.2rem;
  }

  #post-count {
    color: var(--accent);
    font-weight: 700;
  }

  .tag-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 40px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--line);
  }

  .filter-chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(16, 19, 34, 0.6);
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition:
      color 140ms ease,
      border-color 140ms ease,
      background 140ms ease;
  }

  .filter-chip:hover {
    color: var(--accent);
    border-color: rgba(125, 249, 255, 0.5);
  }

  .filter-chip.is-active {
    color: var(--bg);
    background: var(--accent);
    border-color: var(--accent);
  }

  .chip-count {
    opacity: 0.7;
    font-size: 0.72rem;
  }

  .filter-chip.is-active .chip-count {
    opacity: 0.85;
  }

  .year-group {
    margin-bottom: 48px;
  }

  .year-label {
    margin: 0 0 20px;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.24em;
  }

  .archive-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .archive-item {
    display: flex;
  }

  .archive-item[hidden] {
    display: none;
  }

  .archive-item > :global(.post-card) {
    width: 100%;
  }

  .no-results {
    padding: 40px 0;
    color: var(--muted);
    text-align: center;
  }

  @media (max-width: 760px) {
    .archive-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
