---
import { sitePath } from "../../lib/paths";
import { formatDate, getPublishedPosts } from "../../lib/posts";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = await getPublishedPosts();
---

<BaseLayout title="Posts" description="All transmissions from Pre-Singularity Dispatches.">
  <section class="archive-hero">
    <p class="eyebrow">Signal archive</p>
    <h1>Every note from the threshold.</h1>
    <p>Browse the full collection: observations, field notes, and personal essays from the AI transition.</p>
  </section>

  <section class="archive-list" aria-label="All posts">
    {
      posts.length > 0 ? (
        posts.map((post) => (
          <a class="post-card archive-card" href={sitePath(`posts/${post.id}/`)}>
            <div>
              <span class="post-meta">{formatDate(post.data.publishDate)}</span>
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
            </div>
            <div class="tag-list">
              {post.data.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </a>
        ))
      ) : (
        <p class="empty-signal">No published transmissions yet. Drafts stay offline until ready.</p>
      )
    }
  </section>
</BaseLayout>

<style>
  .archive-hero {
    max-width: 820px;
    padding: clamp(56px, 8vw, 108px) 0 48px;
  }

  .archive-hero h1 {
    margin: 12px 0 18px;
    font-family: var(--serif);
    font-size: clamp(3rem, 7vw, 6.7rem);
    font-weight: 500;
    line-height: 0.96;
    letter-spacing: -0.065em;
  }

  .archive-hero p:not(.eyebrow) {
    max-width: 640px;
    margin: 0;
    color: var(--muted);
    font-size: 1.2rem;
  }

  .archive-list {
    display: grid;
    gap: 18px;
    padding-bottom: 32px;
  }

  .archive-card {
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
  }

  .empty-signal {
    margin: 0;
    color: var(--muted);
    font-size: 1.05rem;
  }

  @media (max-width: 720px) {
    .archive-card {
      grid-template-columns: 1fr;
    }
  }
</style>
