---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { sitePath } from "../../lib/paths";
import { collectTags, getSortedPosts, tagSlug } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getSortedPosts();
  const tags = collectTags(posts);

  return tags.map((tag) => ({
    params: { tag: tag.slug },
    props: {
      label: tag.tag,
      posts: posts.filter((post) => post.data.tags.some((t) => tagSlug(t) === tag.slug)),
    },
  }));
}

const { label, posts } = Astro.props;
---

<BaseLayout
  title={`#${label}`}
  description={`Transmissions tagged ${label} from Pre-Singularity Dispatches.`}
>
  <section class="tag-hero">
    <a class="back-link" href={sitePath("tags/")}>All tags</a>
    <p class="eyebrow">Signal thread</p>
    <h1>{label}</h1>
    <p>{posts.length} {posts.length === 1 ? "transmission" : "transmissions"} on this frequency.</p>
  </section>

  <div class="tag-posts">
    {posts.map((post) => <PostCard post={post} heading="h2" />)}
  </div>
</BaseLayout>

<style>
  .tag-hero {
    max-width: 820px;
    padding: clamp(48px, 8vw, 92px) 0 40px;
  }

  .back-link {
    display: inline-flex;
    margin-bottom: 28px;
    color: var(--muted);
    font-size: 0.92rem;
    font-weight: 750;
    text-decoration: none;
  }

  .back-link::before {
    content: "<";
    margin-right: 8px;
    color: var(--accent);
  }

  .back-link:hover {
    color: var(--accent);
  }

  .tag-hero h1 {
    margin: 12px 0 14px;
    font-family: var(--serif);
    font-size: clamp(2.8rem, 8vw, 6.4rem);
    font-weight: 500;
    line-height: 0.94;
    letter-spacing: -0.06em;
  }

  .tag-hero h1::before {
    content: "#";
    color: var(--accent);
    margin-right: 0.06em;
  }

  .tag-hero p:not(.eyebrow) {
    margin: 0;
    color: var(--muted);
    font-size: 1.2rem;
  }

  .tag-posts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    padding-bottom: 40px;
  }

  @media (max-width: 760px) {
    .tag-posts {
      grid-template-columns: 1fr;
    }
  }
</style>
